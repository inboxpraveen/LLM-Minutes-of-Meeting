# MoM AI — optional environment overrides.
#
# You do not need this file. Copy it to .env only if you want to change one of
# the values below. Everything else — API keys, models, retention, prompts — is
# configured from the Settings screen after you sign in, and is stored encrypted
# on this machine.
#
#   cp .env.example .env


# ── Where the app listens ─────────────────────────────────────────────
# APP_PORT=5000


# ── Where your data lives ─────────────────────────────────────────────
# Database, uploads, logs and the encryption key. Defaults to the standard
# per-user data directory for your OS, or /data inside Docker.
#   Windows:  %LOCALAPPDATA%\MoM-AI
#   macOS:    ~/Library/Application Support/MoM-AI
#   Linux:    ~/.local/share/MoM-AI
# MOM_DATA_DIR=


# ── Local transcription ───────────────────────────────────────────────
# Build the image with Whisper included so you can transcribe with no API key.
# Adds roughly 500 MB to the image.
# WITH_LOCAL_WHISPER=true


# ── Background jobs ───────────────────────────────────────────────────
# Docker Compose sets these for you. Only needed when running without Docker.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# WORKER_CONCURRENCY=2


# ── Database ──────────────────────────────────────────────────────────
# SQLite by default. Point at PostgreSQL for a larger deployment.
# DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/momai


# ── Logging ───────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=console        # console | json


# ── Behind a reverse proxy ────────────────────────────────────────────
# BEHIND_PROXY=true
# SESSION_COOKIE_SECURE=true


# ── Session signing key ───────────────────────────────────────────────
# Generated automatically and stored in your data directory. Set it here only
# if you run several web containers and need them to share sessions.
# SECRET_KEY=
